# Maintainer: roman-petruzela
pkgname=tokenusage
pkgver=0.1.0
pkgrel=1
pkgdesc='Claude Pro/Max usage tracker: TUI and JSON output for Waybar/Quickshell'
arch=(x86_64 aarch64)
url="https://github.com/roman-petruzela/tokenusage"
license=(MIT)
depends=(glibc)
makedepends=(go)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('64579959cd9b3e9c0f2062e3bde38afe5a714897d0fd96c7310389922fb98b78')

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-linkmode=external -X main.version=$pkgver" -o "$pkgname" ./cmd/tokenusage
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/share/$pkgname"
  cp -r contrib "$pkgdir/usr/share/$pkgname/contrib"
  install -Dm644 contrib/systemd/tokenusage-refresh.service contrib/systemd/tokenusage-refresh.timer -t "$pkgdir/usr/lib/systemd/user/"
}
